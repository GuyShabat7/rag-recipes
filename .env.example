# Copy this file to .env and fill in your key.
#
# Default LLM: Gemini 2.5 Flash, via Google's OpenAI-compatible endpoint.
GEMINI_API_KEY=

# Alternative: OpenAI. To use it, set the key below and edit configs/config.yaml —
# change `llm.model` (e.g. gpt-4o-mini) and remove the `llm.base_url` line.
# OPENAI_API_KEY=
